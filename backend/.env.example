# ─── SMTP (PHPMailer) ────────────────────────────────────────────────────────
# Exemplo com Gmail — use uma "Senha de App" (não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=techweekfb@gmail.com
SMTP_PASS=sua_senha_de_app

MAIL_FROM=techweekfb@gmail.com
MAIL_FROM_NAME=TechWeek 2026

# URL base do projeto (sem barra final) — usada no link de verificação
APP_URL=https://techweekfb.com.br

# E-mail que recebe notificações internas de novas inscrições
ADMIN_EMAIL=techweekfb@gmail.com

# ─── Sessão ────────────────────────────────────────────────────────────────────
SESSION_NAME=tw26_session
SESSION_SECURE=0          # 1 em produção (HTTPS) — cookie Secure + SameSite=None

# ─── Admin inicial (backend/bin/make-admin.php) ───────────────────────────────
# ADMIN_PASSWORD define a senha do admin criado/atualizado pelo script
ADMIN_PASSWORD=sua_senha_forte

# ─── Pagamento PIX (exibido ao participante) ──────────────────────────────────
